  #block(width: 85%)[
    #set par(justify: false)
    #text(size: 0.9em, weight: 600)[EPHES. 5. 25, etc.]

    #text(style: "italic")[Husbands love your own wives, even as Christ also loved the Church, etc.]
  ]
