# ./fgb build output
/dist/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Generated pages: ebook XHTML, previews, side-by-side reading copies,
# downloaded web pages. Hand-written pages that feed the EPUB are kept.
*.html
*.xhtml
!ebook-front.html
!ebook-appendix.html

# Built PDFs and EPUBs, for books whose builds are reproducible from the
# repository (./fgb pdf / epub). Add a book's folder here when it moves.
books/anonymous/the-anatomy-of-simon-magus/*.pdf
books/anonymous/the-anatomy-of-simon-magus/*.epub
books/william-perkins/christian-economy/*.pdf
books/william-perkins/christian-economy/*.epub
books/william-gouge/domestical-duties/*.pdf
books/william-gouge/domestical-duties/*.epub
