# ./fgb build output
/dist/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Generated pages: ebook XHTML, previews, side-by-side reading copies,
# downloaded web pages. Hand-written pages that feed the EPUB are kept.
*.html
*.xhtml
!ebook-front.html
!ebook-appendix.html

# Built PDFs and EPUBs, for books whose builds are reproducible from the
# repository (./fgb pdf / epub). Add a book's folder here when it moves.
books/charles-spurgeon/all-of-grace/*.pdf
books/charles-spurgeon/all-of-grace/*.epub
books/john-bunyan/the-pilgrims-progress/*.pdf
books/john-bunyan/the-pilgrims-progress/*.epub
books/anonymous/the-anatomy-of-simon-magus/*.pdf
books/anonymous/the-anatomy-of-simon-magus/*.epub
books/william-perkins/christian-economy/*.pdf
books/william-perkins/christian-economy/*.epub
books/william-gouge/domestical-duties/*.pdf
books/william-gouge/domestical-duties/*.epub
books/richard-sibbes/the-glorious-feast-of-the-gospel/*.pdf
books/richard-sibbes/the-glorious-feast-of-the-gospel/*.epub
books/thomas-brooks/the-secret-key-of-heaven/the-secret-key-of-heaven.pdf
books/thomas-brooks/the-secret-key-of-heaven/cover.pdf
books/thomas-brooks/the-secret-key-of-heaven/*.epub
books/jonathan-edwards/sinners-in-the-hands-of-an-angry-god/*.pdf
