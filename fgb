#!/usr/bin/env bash
# fgb: the TEI book pipeline in one command (colophon, the colophon/ submodule;
# see colophon/fgb.py or ./fgb --help). Works from any folder. uv keeps
# colophon's environment (colophon/.venv) to the versions in colophon/uv.lock.
set -e
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ ! -f "$repo/colophon/fgb.py" ]; then
    echo "fgb: colophon is not checked out: git -C '$repo' submodule update --init colophon" >&2
    exit 1
fi
if ! command -v uv >/dev/null; then
    echo "fgb: needs uv (https://docs.astral.sh/uv/; Arch: pacman -S uv)" >&2
    exit 1
fi
export FGB_LIBRARY="$repo"
exec uv run --quiet --locked --project "$repo/colophon" python "$repo/colophon/fgb.py" "$@"
