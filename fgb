#!/usr/bin/env bash
# fgb: the TEI book pipeline in one command (colophon, the colophon/ submodule;
# see colophon/fgb.py or ./fgb --help). Works from any folder; sets up the
# Python environment the first time.
set -e
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ ! -f "$repo/colophon/fgb.py" ]; then
    echo "fgb: colophon is not checked out: git -C '$repo' submodule update --init colophon" >&2
    exit 1
fi
venv="${FGB_VENV:-$HOME/.venvs/fgb-tei}"
if [ ! -x "$venv/bin/python" ]; then
    echo "fgb: setting up $venv (once) ..." >&2
    python3 -m venv "$venv"
    "$venv/bin/pip" install -q -r "$repo/colophon/requirements.txt"
fi
export FGB_LIBRARY="$repo"
exec "$venv/bin/python" "$repo/colophon/fgb.py" "$@"
